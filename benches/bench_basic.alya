## Benchmark suite for the logger package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "../src/lib.alya" as log

function main()
    let runner = bench_runner("Alya Logger Micro-Benchmarks")

    # 1. Logger initialization & configuration
    bench_start(runner, 2000)
    let i = 0
    while i < 2000
        let l = log::create("BenchApp", log::LogLevel.Info)
        log::logger_set_colored(l, 0)
        log::logger_set_timestamps(l, 1)
        log::logger_add_field(l, "env", "production")
        log::logger_add_field(l, "version", "1.0.0")
        i += 1
    end
    bench_stop(runner, "logger::create + config + fields (2k runs)")

    # 2. Text record formatting
    let f1 = log::field("user_id", "42")
    let f2 = log::field("action", "login")
    let rec_text = log::record(log::LogLevel.Info, "User authenticated successfully", "auth", 1700000000, [f1, f2])

    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        log::format_record_text(rec_text, 0, 1)
        j += 1
    end
    bench_stop(runner, "format_record_text with fields + timestamp (2k runs)")

    # 3. JSON record formatting
    bench_start(runner, 2000)
    let k = 0
    while k < 2000
        log::format_record_json(rec_text)
        k += 1
    end
    bench_stop(runner, "format_record_json with fields (2k runs)")

    # 4. Level filtering rejection (fast path)
    let l_filter = log::create("FilterBench", log::LogLevel.Warn)
    bench_start(runner, 2000)
    let m = 0
    while m < 2000
        log::logger_log(l_filter, log::LogLevel.Debug, "Should be skipped immediately")
        m += 1
    end
    bench_stop(runner, "logger_log filtered level rejection (2k runs)")

    bench_summary(runner)
end

main()
