# Test suite for Log Levels, Conversions, and Badges
import "std/test"
import "../src/lib.alya" as log

function main()
    test_suite("Logger Levels & Badges Tests")
    let r = runner_new()

    # 1. Level to string conversion
    runner_assert_str_eq(r, log::level_to_str(log::LOG_TRACE()), "TRACE", "level 0 is TRACE")
    runner_assert_str_eq(r, log::level_to_str(log::LOG_DEBUG()), "DEBUG", "level 1 is DEBUG")
    runner_assert_str_eq(r, log::level_to_str(log::LOG_INFO()),  "INFO",  "level 2 is INFO")
    runner_assert_str_eq(r, log::level_to_str(log::LOG_WARN()),  "WARN",  "level 3 is WARN")
    runner_assert_str_eq(r, log::level_to_str(log::LOG_ERROR()), "ERROR", "level 4 is ERROR")
    runner_assert_str_eq(r, log::level_to_str(log::LOG_FATAL()), "FATAL", "level 5 is FATAL")
    runner_assert_str_eq(r, log::level_to_str(log::LOG_OFF()),   "OFF",   "level 6 is OFF")
    runner_assert_str_eq(r, log::level_to_str(99),               "LOG",   "unknown level returns LOG")

    # 2. Namespaced level getters
    runner_assert_eq(r, log::level_trace(), 0, "level_trace() returns 0")
    runner_assert_eq(r, log::level_debug(), 1, "level_debug() returns 1")
    runner_assert_eq(r, log::level_info(),  2, "level_info() returns 2")
    runner_assert_eq(r, log::level_warn(),  3, "level_warn() returns 3")
    runner_assert_eq(r, log::level_error(), 4, "level_error() returns 4")
    runner_assert_eq(r, log::level_fatal(), 5, "level_fatal() returns 5")
    runner_assert_eq(r, log::level_off(),   6, "level_off() returns 6")

    # 3. String to level conversion (case-insensitive)
    runner_assert_eq(r, log::level_from_str("trace"), log::LOG_TRACE(), "parses 'trace' to 0")
    runner_assert_eq(r, log::level_from_str("TRACE"), log::LOG_TRACE(), "parses 'TRACE' to 0")
    runner_assert_eq(r, log::level_from_str("debug"), log::LOG_DEBUG(), "parses 'debug' to 1")
    runner_assert_eq(r, log::level_from_str("DEBUG"), log::LOG_DEBUG(), "parses 'DEBUG' to 1")
    runner_assert_eq(r, log::level_from_str("info"), log::LOG_INFO(), "parses 'info' to 2")
    runner_assert_eq(r, log::level_from_str("Info"), log::LOG_INFO(), "parses 'Info' to 2")
    runner_assert_eq(r, log::level_from_str("warn"), log::LOG_WARN(), "parses 'warn' to 3")
    runner_assert_eq(r, log::level_from_str("WARNING"), log::LOG_WARN(), "parses 'WARNING' to 3")
    runner_assert_eq(r, log::level_from_str("error"), log::LOG_ERROR(), "parses 'error' to 4")
    runner_assert_eq(r, log::level_from_str("fatal"), log::LOG_FATAL(), "parses 'fatal' to 5")
    runner_assert_eq(r, log::level_from_str("off"), log::LOG_OFF(), "parses 'off' to 6")
    runner_assert_eq(r, log::level_from_str("invalid_str"), log::LOG_INFO(), "unknown defaults to INFO (2)")

    # 4. Badges without color
    let b_trace = log::level_badge(log::LOG_TRACE(), 0)
    let b_info  = log::level_badge(log::LOG_INFO(), 0)
    let b_warn  = log::level_badge(log::LOG_WARN(), 0)
    let b_fatal = log::level_badge(log::LOG_FATAL(), 0)

    runner_assert_str_eq(r, b_trace, "[TRACE]", "plain badge for TRACE")
    runner_assert_str_eq(r, b_info,  "[INFO] ", "plain badge for INFO padded to 7")
    runner_assert_str_eq(r, b_warn,  "[WARN] ", "plain badge for WARN padded to 7")
    runner_assert_str_eq(r, b_fatal, "[FATAL]", "plain badge for FATAL")
    runner_assert_eq(r, len(b_trace), 7, "badge length is 7")
    runner_assert_eq(r, len(b_info),  7, "badge length is 7")

    # 5. Badges with ANSI color
    let b_color_info = log::level_badge(log::LOG_INFO(), 1)
    let b_color_warn = log::level_badge(log::LOG_WARN(), 1)
    runner_assert_str_eq(r, log::ansi_strip(b_color_info), "[INFO] ", "stripping ANSI from colored badge yields plain")
    runner_assert_str_eq(r, log::ansi_strip(b_color_warn), "[WARN] ", "stripping ANSI from colored badge yields plain")

    # 6. Backward compatibility aliases
    runner_assert_str_eq(r, log::log_level_name(log::LOG_INFO()), "INFO", "log_level_name matches INFO")
    runner_assert_eq(r, log::log_level_from_str("ERROR"), log::LOG_ERROR(), "log_level_from_str matches ERROR")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
