## Test suite for Log Levels, Conversions, and Badges
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as log

function main()
    test_suite("Logger Levels & Badges Tests")
    let r = runner_new()

    # 1. Level to string conversion
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Trace), "TRACE", "level 0 is TRACE")
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Debug), "DEBUG", "level 1 is DEBUG")
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Info),  "INFO",  "level 2 is INFO")
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Warn),  "WARN",  "level 3 is WARN")
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Error), "ERROR", "level 4 is ERROR")
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Fatal), "FATAL", "level 5 is FATAL")
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Off),   "OFF",   "level 6 is OFF")
    runner_assert_str_eq(r, log::level_to_str(99),               "LOG",   "unknown level returns LOG")

    # 2. Namespaced level getters
    runner_assert_eq(r, log::LogLevel.Trace, 0, "level_trace() returns 0")
    runner_assert_eq(r, log::LogLevel.Debug, 1, "level_debug() returns 1")
    runner_assert_eq(r, log::LogLevel.Info,  2, "level_info() returns 2")
    runner_assert_eq(r, log::LogLevel.Warn,  3, "level_warn() returns 3")
    runner_assert_eq(r, log::LogLevel.Error, 4, "level_error() returns 4")
    runner_assert_eq(r, log::LogLevel.Fatal, 5, "level_fatal() returns 5")
    runner_assert_eq(r, log::LogLevel.Off,   6, "level_off() returns 6")

    # 3. String to level conversion (case-insensitive)
    runner_assert_eq(r, log::level_from_str("trace"), log::LogLevel.Trace, "parses 'trace' to 0")
    runner_assert_eq(r, log::level_from_str("TRACE"), log::LogLevel.Trace, "parses 'TRACE' to 0")
    runner_assert_eq(r, log::level_from_str("debug"), log::LogLevel.Debug, "parses 'debug' to 1")
    runner_assert_eq(r, log::level_from_str("DEBUG"), log::LogLevel.Debug, "parses 'DEBUG' to 1")
    runner_assert_eq(r, log::level_from_str("info"), log::LogLevel.Info, "parses 'info' to 2")
    runner_assert_eq(r, log::level_from_str("Info"), log::LogLevel.Info, "parses 'Info' to 2")
    runner_assert_eq(r, log::level_from_str("warn"), log::LogLevel.Warn, "parses 'warn' to 3")
    runner_assert_eq(r, log::level_from_str("WARNING"), log::LogLevel.Warn, "parses 'WARNING' to 3")
    runner_assert_eq(r, log::level_from_str("error"), log::LogLevel.Error, "parses 'error' to 4")
    runner_assert_eq(r, log::level_from_str("fatal"), log::LogLevel.Fatal, "parses 'fatal' to 5")
    runner_assert_eq(r, log::level_from_str("off"), log::LogLevel.Off, "parses 'off' to 6")
    runner_assert_eq(r, log::level_from_str("invalid_str"), log::LogLevel.Info, "unknown defaults to INFO (2)")

    # 4. Badges without color
    let b_trace = log::level_badge(log::LogLevel.Trace, 0)
    let b_info  = log::level_badge(log::LogLevel.Info, 0)
    let b_warn  = log::level_badge(log::LogLevel.Warn, 0)
    let b_fatal = log::level_badge(log::LogLevel.Fatal, 0)

    runner_assert_str_eq(r, b_trace, "[TRACE]", "plain badge for TRACE")
    runner_assert_str_eq(r, b_info,  "[INFO] ", "plain badge for INFO padded to 7")
    runner_assert_str_eq(r, b_warn,  "[WARN] ", "plain badge for WARN padded to 7")
    runner_assert_str_eq(r, b_fatal, "[FATAL]", "plain badge for FATAL")
    runner_assert_eq(r, len(b_trace), 7, "badge length is 7")
    runner_assert_eq(r, len(b_info),  7, "badge length is 7")

    # 5. Badges with ANSI color
    let b_color_info = log::level_badge(log::LogLevel.Info, 1)
    let b_color_warn = log::level_badge(log::LogLevel.Warn, 1)
    runner_assert_str_eq(r, log::ansi_strip(b_color_info), "[INFO] ", "stripping ANSI from colored badge yields plain")
    runner_assert_str_eq(r, log::ansi_strip(b_color_warn), "[WARN] ", "stripping ANSI from colored badge yields plain")

    # 6. Canonical level conversions
    runner_assert_str_eq(r, log::level_to_str(log::LogLevel.Info), "INFO", "level_to_str matches INFO")
    runner_assert_eq(r, log::level_from_str("ERROR"), log::LogLevel.Error, "level_from_str matches ERROR")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
