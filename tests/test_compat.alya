# Test suite for 100% backward compatibility with std/log
import "std/test"
import "../src/lib.alya" as log

function main()
    test_suite("Logger Compatibility with std/log Tests")
    let r = runner_new()

    # 1. Verification of std/log level constants
    runner_assert_eq(r, log::LOG_DEBUG(), 1, "LOG_DEBUG is 1")
    runner_assert_eq(r, log::LOG_INFO(),  2, "LOG_INFO is 2")
    runner_assert_eq(r, log::LOG_WARN(),  3, "LOG_WARN is 3")
    runner_assert_eq(r, log::LOG_ERROR(), 4, "LOG_ERROR is 4")
    runner_assert_eq(r, log::LOG_FATAL(), 5, "LOG_FATAL is 5")
    runner_assert_eq(r, log::LOG_OFF(),   6, "LOG_OFF is 6")

    # 2. std/log log_level_name and log_level_from_str
    runner_assert_str_eq(r, log::log_level_name(1), "DEBUG", "level 1 is DEBUG")
    runner_assert_str_eq(r, log::log_level_name(2), "INFO", "level 2 is INFO")
    runner_assert_str_eq(r, log::log_level_name(3), "WARN", "level 3 is WARN")
    runner_assert_str_eq(r, log::log_level_name(4), "ERROR", "level 4 is ERROR")
    runner_assert_str_eq(r, log::log_level_name(5), "FATAL", "level 5 is FATAL")

    runner_assert_eq(r, log::log_level_from_str("DEBUG"), 1, "from_str DEBUG is 1")
    runner_assert_eq(r, log::log_level_from_str("INFO"), 2, "from_str INFO is 2")
    runner_assert_eq(r, log::log_level_from_str("WARN"), 3, "from_str WARN is 3")
    runner_assert_eq(r, log::log_level_from_str("WARNING"), 3, "from_str WARNING is 3")
    runner_assert_eq(r, log::log_level_from_str("ERROR"), 4, "from_str ERROR is 4")
    runner_assert_eq(r, log::log_level_from_str("FATAL"), 5, "from_str FATAL is 5")
    runner_assert_eq(r, log::log_level_from_str("OFF"), 6, "from_str OFF is 6")

    # 3. std/log logger_new and methods
    let app_logger = log::logger_new("ApiGateway", 2)
    runner_assert_str_eq(r, app_logger.log_name, "ApiGateway", "name matches")
    runner_assert_eq(r, app_logger.log_level, 2, "level matches INFO")
    runner_assert_eq(r, app_logger.log_colored, 1, "colored default matches 1")
    runner_assert_eq(r, app_logger.log_timestamps, 0, "timestamps default matches 0")
    runner_assert_str_eq(r, app_logger.log_file, "", "file default matches empty")

    log::logger_set_level(app_logger, 3)
    runner_assert_eq(r, app_logger.log_level, 3, "set_level updates to 3")

    log::logger_set_colored(app_logger, 0)
    runner_assert_eq(r, app_logger.log_colored, 0, "set_colored updates to 0")

    log::logger_set_timestamps(app_logger, 1)
    runner_assert_eq(r, app_logger.log_timestamps, 1, "set_timestamps updates to 1")

    let compat_file = "temp_compat_file.log"
    if file_exists(compat_file) == 1
        remove_file(compat_file)
    end

    log::logger_set_file(app_logger, compat_file)
    runner_assert_str_eq(r, app_logger.log_file, compat_file, "set_file updates log_file")

    # 4. Leveled logging calls
    runner_assert_eq(r, log::logger_debug(app_logger, "Filtered debug message"), 0, "debug is filtered when level is 3")
    runner_assert_eq(r, log::logger_info(app_logger, "Filtered info message"), 0, "info is filtered when level is 3")
    runner_assert_eq(r, log::logger_warn(app_logger, "Warning event"), 1, "warn is logged when level is 3")
    runner_assert_eq(r, log::logger_error(app_logger, "Error event"), 1, "error is logged when level is 3")
    runner_assert_eq(r, log::logger_fatal(app_logger, "Fatal event"), 1, "fatal is logged when level is 3")

    runner_assert_eq(r, file_exists(compat_file), 1, "compat file was written")
    let file_data = read_file(compat_file)
    runner_assert_true(r, len(file_data) > 0, "compat file has content")

    if file_exists(compat_file) == 1
        remove_file(compat_file)
    end

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
