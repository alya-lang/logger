## # logger/appenders
##
## Console, file, and rolling file appenders.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./utils.alya"

## Outputs a line to console standard output.
##
## ### Parameters
## - `line`: Line string.
pub function append_console(line: string)
    say line
end

## Appends a line to a target file (ANSI codes stripped before writing).
##
## Requires the `file` feature (default-on).
##
## ### Parameters
## - `path`: Destination file path string.
## - `line`: Line string.
@cfg(feature = "file")
pub function append_to_file(path: string, line: string)
    let clean = ansi_strip(line)
    append_file(path, f"{clean}\n")
end

## Rotates a log file when it exceeds its size budget.
##
## Backups are named `path.1`, `path.2`, ... `path.<max_files>`.
## Requires the `file` feature (default-on).
##
## ### Parameters
## - `path`: Active log file path string.
## - `max_files`: Retained backup count integer.
##
## ### Returns
## `1` on completion.
@cfg(feature = "file")
pub function rotate_log_file(path: string, max_files: int) -> int
    if max_files <= 0
        remove_file(path)
        return 1
    end

    # 1. Remove oldest backup if it exists
    let oldest = f"{path}.{max_files}"
    if file_exists(oldest) == true
        remove_file(oldest)
    end

    # 2. Shift backups down (.2 -> .3, .1 -> .2)
    let i = max_files - 1
    while i >= 1
        let cur = f"{path}.{i}"
        let nxt_num = i + 1
        let nxt = f"{path}.{nxt_num}"
        if file_exists(cur) == true
            file_move(cur, nxt)
        end
        i -= 1
    end

    # 3. Move current active log to .1
    let first = f"{path}.1"
    file_move(path, first)
    return 1
end

## Appends a line to a rolling file, rotating past the size threshold.
##
## Requires the `file` feature (default-on).
##
## ### Parameters
## - `path`: Destination file path string.
## - `line`: Line string.
## - `max_size`: Rotation threshold bytes integer.
## - `max_files`: Retained backup count integer.
@cfg(feature = "file")
pub function append_to_rolling_file(path: string, line: string, max_size: int, max_files: int)
    let clean = ansi_strip(line)
    let content = f"{clean}\n"
    let line_len = len(content)

    if max_size > 0 and file_exists(path) == true
        let cur_size = file_size(path)
        if cur_size + line_len > max_size
            rotate_log_file(path, max_files)
        end
    end

    append_file(path, content)
end
