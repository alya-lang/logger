# Text and JSON formatters for LogRecord
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./utils.alya"
import "./levels.alya"

## Formats record into a human-readable text line with optional colors and timestamps.
pub function format_text(rec, colored, timestamps)
    let prefix = ""
    if timestamps == 1
        let ts_str = format_time_hms(rec.rec_time)
        prefix = prefix + "[" + ts_str + "] "
    end

    let target_str = str_from_ptr(rec.rec_target)
    if len(target_str) > 0
        if colored == 1
            prefix = prefix + "\e[35m[" + target_str + "]\e[0m "
        else
            prefix = prefix + "[" + target_str + "] "
        end
    end

    let badge = level_badge(rec.rec_level, colored)
    let msg = str_from_ptr(rec.rec_msg)
    let res = prefix + badge + " " + msg

    let flds = rec.rec_fields
    if len(flds) > 0
        for f in flds
            let k = str_from_ptr(f.fld_key)
            let v = str_from_ptr(f.fld_value)
            if has_space(v) == 1
                res = res + " " + k + "=\"" + v + "\""
            else
                res = res + " " + k + "=" + v
            end
        end
    end
    return res
end

## Formats record into a compact JSON string suitable for log ingestion.
pub function format_json(rec)
    let lvl = level_to_str(rec.rec_level)
    let msg = json_escape_str(rec.rec_msg)
    let target = json_escape_str(rec.rec_target)
    let ts = rec.rec_time

    let out = "{\"level\":\"" + lvl + "\",\"time\":" + str(ts)
    if len(target) > 0
        out = out + ",\"target\":\"" + target + "\""
    end
    out = out + ",\"msg\":\"" + msg + "\""

    let flds = rec.rec_fields
    let flen = len(flds)
    if flen > 0
        out = out + ",\"fields\":{"
        for i, f in flds
            let k = json_escape_str(f.fld_key)
            let v = json_escape_str(f.fld_value)
            if i > 0
                out = out + ","
            end
            out = out + "\"" + k + "\":\"" + v + "\""
        end
        out = out + "}"
    end
    out = out + "}"
    return out
end
