## # logger/formatters
##
## Text and JSON formatters for LogRecord.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./utils.alya"
import "./levels.alya"

## Formats a record into a human-readable text line.
##
## ### Parameters
## - `rec`: Target `LogRecord` instance.
## - `colored`: `1` enables ANSI colors, `0` returns plain text.
## - `timestamps`: `1` prefixes timestamps, `0` hides them.
##
## ### Returns
## The formatted line string.
pub function format_text(rec, colored: int, timestamps: int) -> string
    let prefix = ""
    if timestamps == true
        let ts_str = format_time_hms(rec.rec_time)
        prefix += f"[{ts_str}] "
    end

    let target_str = str_from_ptr(rec.rec_target)
    if len(target_str) > 0
        if colored == true
            prefix += f"\e[35m[{target_str}]\e[0m "
        else
            prefix += f"[{target_str}] "
        end
    end

    let badge = level_badge(rec.rec_level, colored)
    let msg = str_from_ptr(rec.rec_msg)
    let res = f"{prefix}{badge} {msg}"

    let flds = rec.rec_fields
    if len(flds) > 0
        for f in flds
            let k = str_from_ptr(f.fld_key)
            let v = str_from_ptr(f.fld_value)
            if has_space(v) == true
                res += f" {k}=\"{v}\""
            else
                res += f" {k}={v}"
            end
        end
    end
    return res
end

## Formats a record into a compact JSON string for log ingestion.
##
## ### Parameters
## - `rec`: Target `LogRecord` instance.
##
## ### Returns
## The JSON line string.
##
## Requires the `json` feature (default-on).
@cfg(feature = "json")
pub function format_json(rec) -> string
    let lvl = level_to_str(rec.rec_level)
    let msg = json_escape_str(rec.rec_msg)
    let target = json_escape_str(rec.rec_target)
    let ts = rec.rec_time

    let out = f"{{\"level\":\"{lvl}\",\"time\":{ts}"
    if len(target) > 0
        out += f",\"target\":\"{target}\""
    end
    out += f",\"msg\":\"{msg}\""

    let flds = rec.rec_fields
    let flen = len(flds)
    if flen > 0
        out += ",\"fields\":{"
        for i, f in flds
            let k = json_escape_str(f.fld_key)
            let v = json_escape_str(f.fld_value)
            if i > 0
                out += ","
            end
            out += f"\"{k}\":\"{v}\""
        end
        out += "}"
    end
    out += "}"
    return out
end
