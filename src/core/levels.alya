## # logger/levels
##
## Log level conversions, labels, and ANSI styling.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"

## Converts a numeric log level to its canonical string form.
##
## ### Parameters
## - `lvl`: `LogLevel` value.
##
## ### Returns
## The level name string (`"LOG"` when unknown).
pub function level_to_str(lvl: int) -> string
    return when lvl
        is LogLevel.Trace => "TRACE"
        is LogLevel.Debug => "DEBUG"
        is LogLevel.Info  => "INFO"
        is LogLevel.Warn  => "WARN"
        is LogLevel.Error => "ERROR"
        is LogLevel.Fatal => "FATAL"
        is LogLevel.Off   => "OFF"
        else              => "LOG"
    end
end

## Parses a string representation into a numeric LogLevel value.
##
## Unknown names fall back to Info.
##
## ### Parameters
## - `s`: Level name value.
##
## ### Returns
## The `LogLevel` value.
pub function level_from_str(s) -> int
    let up = upper(str_from_ptr(s))
    return when up
        is "TRACE"            => LogLevel.Trace
        is "DEBUG"            => LogLevel.Debug
        is "INFO"             => LogLevel.Info
        is "WARN", "WARNING"  => LogLevel.Warn
        is "ERROR"            => LogLevel.Error
        is "FATAL"            => LogLevel.Fatal
        is "OFF"              => LogLevel.Off
        else                  => LogLevel.Info
    end
end

# Private ANSI escape helper (internal encapsulation).
function _ansi_esc(code: string, s) -> string
    let body = str_from_ptr(s)
    return "\e[{code}m{body}\e[0m"
end

## Returns a styled badge string for a log level with optional colors.
##
## ### Parameters
## - `lvl`: `LogLevel` value.
## - `colored`: `1` enables ANSI colors, `0` returns plain text.
##
## ### Returns
## The padded badge string (e.g. `"[INFO] "`).
pub function level_badge(lvl: int, colored: int) -> string
    let name = level_to_str(lvl)
    let badge = "[{name}]"
    while len(badge) < 7
        badge += " "
    end

    if colored == 0
        return badge
    end

    return when lvl
        is LogLevel.Trace => _ansi_esc("90", badge)
        is LogLevel.Debug => _ansi_esc("36", badge)
        is LogLevel.Info  => _ansi_esc("32", badge)
        is LogLevel.Warn  => _ansi_esc("33", badge)
        is LogLevel.Error => _ansi_esc("31", badge)
        is LogLevel.Fatal => _ansi_esc("1;91", badge)
        else              => badge
    end
end
