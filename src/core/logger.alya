## # logger/logger
##
## Core logger methods, dispatching, and field management.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"
import "./formatters.alya"
import "./appenders.alya"

## Dispatches a formatted message across configured appenders.
##
## Falls back to console output (plus the static file path) when no
## appenders are registered.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `formatted`: Formatted line string.
pub function logger_dispatch(l: AppLogger, formatted: string)
    let num_apps = len(l.log_appenders)
    if num_apps > 0
        for app in l.log_appenders
            when app.app_type
                is AppenderType.Console then
                    append_console(formatted)
                is AppenderType.File then
                    append_to_file(app.app_target, formatted)
                is AppenderType.Rolling then
                    append_to_rolling_file(app.app_target, formatted, app.app_max_size, app.app_max_files)
            end
        end
    else
        # Default behavior: Console output + optional log_file
        say formatted
        let fpath = str_from_ptr(l.log_file)
        if len(fpath) > 0
            append_to_file(fpath, formatted)
        end
    end
end

## Primary logging function filtering by level and dispatching a record.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `level`: `LogLevel` value.
## - `message`: Message value.
##
## ### Returns
## `1` when emitted, `0` when filtered out.
pub function logger_log(l: AppLogger, level: int, message) -> int
    if level < l.log_level or l.log_level == LogLevel.Off
        return 0
    end

    let rec = record_new(level, message, l.log_name, time(), l.log_fields)
    let formatted = ""
    when l.log_format
        is LogFormat.Json then
            formatted = format_json(rec)
        else
            formatted = format_text(rec, l.log_colored, l.log_timestamps)
    end

    logger_dispatch(l, formatted)
    return 1
end

## Logs a message with call-site structured key-value fields.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `level`: `LogLevel` value.
## - `message`: Message value.
## - `extra_fields`: Additional `LogField` array.
##
## ### Returns
## `1` when emitted, `0` when filtered out.
pub function logger_log_with_fields(l: AppLogger, level: int, message, extra_fields: array) -> int
    if level < l.log_level or l.log_level == LogLevel.Off
        return 0
    end

    let all_fields = []
    for f in l.log_fields
        all_fields.push(f)
    end
    for f in extra_fields
        all_fields.push(f)
    end

    let rec = record_new(level, message, l.log_name, time(), all_fields)
    let formatted = ""
    when l.log_format
        is LogFormat.Json then
            formatted = format_json(rec)
        else
            formatted = format_text(rec, l.log_colored, l.log_timestamps)
    end

    logger_dispatch(l, formatted)
    return 1
end

## Sets the minimum threshold log level.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `level`: `LogLevel` value.
pub function logger_set_level(l: AppLogger, level: int)
    l.log_level = level
end

## Enables or disables ANSI color output (`1` or `0`).
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `colored`: Flag integer.
pub function logger_set_colored(l: AppLogger, colored: int)
    l.log_colored = colored
end

## Enables or disables timestamp prefixes (`1` or `0`).
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `timestamps`: Flag integer.
pub function logger_set_timestamps(l: AppLogger, timestamps: int)
    l.log_timestamps = timestamps
end

## Sets the static log file path.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `file_path`: File path value.
pub function logger_set_file(l: AppLogger, file_path)
    l.log_file = str_from_ptr(file_path)
end

## Sets the output format mode (`LogFormat.Text` or `LogFormat.Json`).
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `format`: `LogFormat` value.
pub function logger_set_format(l: AppLogger, format: int)
    l.log_format = format
end

## Registers a standard console stdout appender.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
pub function logger_add_console(l: AppLogger)
    l.log_appenders.push(appender_console())
end

## Registers a static destination file appender.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `path`: File path value.
pub function logger_add_file(l: AppLogger, path)
    l.log_appenders.push(appender_file(path))
end

## Registers a rolling file appender with size limit and retention.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `path`: File path value.
## - `max_size`: Rotation threshold bytes integer.
## - `max_files`: Retained backup count integer.
pub function logger_add_rolling_file(l: AppLogger, path, max_size: int, max_files: int)
    l.log_appenders.push(appender_rolling(path, max_size, max_files))
end

## Adds a persistent key-value context field to the logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `key`: Field key value.
## - `value`: Field value.
pub function logger_add_field(l: AppLogger, key, value)
    l.log_fields.push(field_new(key, value))
end

## Clears all registered appenders from the logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
pub function logger_clear_appenders(l: AppLogger)
    l.log_appenders = []
end

## Clears all persistent context fields from the logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
pub function logger_clear_fields(l: AppLogger)
    l.log_fields = []
end

## Emits a TRACE level log message.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `msg`: Message value.
##
## ### Returns
## `1` when emitted, `0` when filtered out.
pub function logger_trace(l: AppLogger, msg) -> int return logger_log(l, LogLevel.Trace, msg) end
