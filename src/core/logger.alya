## Emits a log message at the specified level.
##
## ### Parameters
## - `self`: The target `AppLogger` instance.
## - `level`: `LogLevel` value.
## - `message`: Message value.
##
## ### Returns
## `1` when emitted, `0` when filtered out.
pub function AppLogger.log(self: AppLogger, level: int, message) -> int
    return logger_log(self, level, message)
end

