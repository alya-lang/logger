# Core Logger methods, dispatching, and field management
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "./utils.alya"
import "./levels.alya"
import "./formatters.alya"
import "./appenders.alya"

# Dispatches formatted message across configured appenders
pub function logger_dispatch(l, formatted)
    let num_apps = len(l.log_appenders)
    if num_apps > 0
        for app in l.log_appenders
            when app.app_type
                is AppenderType.Console then
                    append_console(formatted)
                is AppenderType.File then
                    append_to_file(app.app_target, formatted)
                is AppenderType.Rolling then
                    append_to_rolling_file(app.app_target, formatted, app.app_max_size, app.app_max_files)
            end
        end
    else
        # Default behavior: Console output + optional log_file
        say formatted
        let fpath = str_from_ptr(l.log_file)
        if len(fpath) > 0
            append_to_file(fpath, formatted)
        end
    end
end

# Primary logging function
pub function logger_log(l, level, message)
    if level < l.log_level or l.log_level == LogLevel.Off
        return 0
    end

    let rec = record_new(level, message, l.log_name, time(), l.log_fields)
    let formatted = ""
    when l.log_format
        is LogFormat.Json then
            formatted = format_json(rec)
        else
            formatted = format_text(rec, l.log_colored, l.log_timestamps)
    end

    logger_dispatch(l, formatted)
    return 1
end

# Logs with extra call-site structured fields
pub function logger_log_with_fields(l, level, message, extra_fields)
    if level < l.log_level or l.log_level == LogLevel.Off
        return 0
    end

    let all_fields = []
    for f in l.log_fields
        all_fields.push(f)
    end
    for f in extra_fields
        all_fields.push(f)
    end

    let rec = record_new(level, message, l.log_name, time(), all_fields)
    let formatted = ""
    when l.log_format
        is LogFormat.Json then
            formatted = format_json(rec)
        else
            formatted = format_text(rec, l.log_colored, l.log_timestamps)
    end

    logger_dispatch(l, formatted)
    return 1
end

# Configuration / fluent setters
pub function logger_set_level(l, level)
    l.log_level = level
end

pub function logger_set_colored(l, colored)
    l.log_colored = colored
end

pub function logger_set_timestamps(l, timestamps)
    l.log_timestamps = timestamps
end

pub function logger_set_file(l, file_path)
    l.log_file = str_from_ptr(file_path)
end

pub function logger_set_format(l, format)
    l.log_format = format
end

pub function logger_add_console(l)
    l.log_appenders.push(appender_console())
end

pub function logger_add_file(l, path)
    l.log_appenders.push(appender_file(path))
end

pub function logger_add_rolling_file(l, path, max_size, max_files)
    l.log_appenders.push(appender_rolling(path, max_size, max_files))
end

pub function logger_add_field(l, key, value)
    l.log_fields.push(field_new(key, value))
end

pub function logger_clear_appenders(l)
    l.log_appenders = []
end

pub function logger_clear_fields(l)
    l.log_fields = []
end

# Leveled convenience logging methods
pub function logger_trace(l, msg) return logger_log(l, LogLevel.Trace, msg) end
pub function logger_debug(l, msg) return logger_log(l, LogLevel.Debug, msg) end
pub function logger_info(l, msg)  return logger_log(l, LogLevel.Info, msg) end
pub function logger_warn(l, msg)  return logger_log(l, LogLevel.Warn, msg) end
pub function logger_error(l, msg) return logger_log(l, LogLevel.Error, msg) end
pub function logger_fatal(l, msg) return logger_log(l, LogLevel.Fatal, msg) end

# Leveled logging with call-site fields
pub function logger_trace_fields(l, msg, fields) return logger_log_with_fields(l, LogLevel.Trace, msg, fields) end
pub function logger_debug_fields(l, msg, fields) return logger_log_with_fields(l, LogLevel.Debug, msg, fields) end
pub function logger_info_fields(l, msg, fields)  return logger_log_with_fields(l, LogLevel.Info, msg, fields) end
pub function logger_warn_fields(l, msg, fields)  return logger_log_with_fields(l, LogLevel.Warn, msg, fields) end
pub function logger_error_fields(l, msg, fields) return logger_log_with_fields(l, LogLevel.Error, msg, fields) end
pub function logger_fatal_fields(l, msg, fields) return logger_log_with_fields(l, LogLevel.Fatal, msg, fields) end

# --- Idiomatic Struct Methods on AppLogger ---

pub function AppLogger.log(self, level, message)
    return logger_log(self, level, message)
end

pub function AppLogger.trace(self, msg)
    return logger_trace(self, msg)
end

pub function AppLogger.debug(self, msg)
    return logger_debug(self, msg)
end

pub function AppLogger.info(self, msg)
    return logger_info(self, msg)
end

pub function AppLogger.warn(self, msg)
    return logger_warn(self, msg)
end

pub function AppLogger.error(self, msg)
    return logger_error(self, msg)
end

pub function AppLogger.fatal(self, msg)
    return logger_fatal(self, msg)
end

pub function AppLogger.trace_fields(self, msg, fields)
    return logger_trace_fields(self, msg, fields)
end

pub function AppLogger.debug_fields(self, msg, fields)
    return logger_debug_fields(self, msg, fields)
end

pub function AppLogger.info_fields(self, msg, fields)
    return logger_info_fields(self, msg, fields)
end

pub function AppLogger.warn_fields(self, msg, fields)
    return logger_warn_fields(self, msg, fields)
end

pub function AppLogger.error_fields(self, msg, fields)
    return logger_error_fields(self, msg, fields)
end

pub function AppLogger.fatal_fields(self, msg, fields)
    return logger_fatal_fields(self, msg, fields)
end

pub function AppLogger.set_level(self, level)
    logger_set_level(self, level)
end

pub function AppLogger.set_colored(self, colored)
    logger_set_colored(self, colored)
end

pub function AppLogger.set_timestamps(self, timestamps)
    logger_set_timestamps(self, timestamps)
end

pub function AppLogger.set_file(self, file_path)
    logger_set_file(self, file_path)
end

pub function AppLogger.set_format(self, format)
    logger_set_format(self, format)
end

pub function AppLogger.add_console(self)
    logger_add_console(self)
end

pub function AppLogger.add_file(self, path)
    logger_add_file(self, path)
end

pub function AppLogger.add_rolling_file(self, path, max_size, max_files)
    logger_add_rolling_file(self, path, max_size, max_files)
end

pub function AppLogger.add_field(self, key, value)
    logger_add_field(self, key, value)
end

pub function AppLogger.clear_appenders(self)
    logger_clear_appenders(self)
end

pub function AppLogger.clear_fields(self)
    logger_clear_fields(self)
end
