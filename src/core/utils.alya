# Utility functions for string manipulation, time formatting, and file operations
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Strips ANSI escape sequences from formatted text
pub function ansi_strip(text)
    let s = str_from_ptr(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c = char_at(s, i)
                let o = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res += ch
        end
        i += 1
    end
    return res
end

# Pads integer with leading zero if single digit
pub function pad2(n)
    if n < 10
        return "0" + str(n)
    end
    return str(n)
end

# Formats UNIX epoch seconds into HH:MM:SS
pub function format_time_hms(secs)
    let day_secs = secs % 86400
    let hh = (day_secs / 3600) % 24
    let mm = (day_secs / 60) % 60
    let ss = day_secs % 60
    return pad2(hh) + ":" + pad2(mm) + ":" + pad2(ss)
end

# Checks if string contains space or delimiter characters requiring quoting
pub function has_space(s)
    let slen = len(s)
    let i = 0
    while i < slen
        let c = char_at(s, i)
        if c in [" ", "\t", "\n", "\"", "="]
            return 1
        end
        i += 1
    end
    return 0
end

# Escapes special characters for JSON encoding using pattern matching
pub function json_escape_str(s)
    let str_val = str_from_ptr(s)
    let slen = len(str_val)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(str_val, i)
        let escaped = when ch
            is "\"" => "\\\""
            is "\\" => "\\\\"
            is "\n" => "\\n"
            is "\r" => "\\r"
            is "\t" => "\\t"
            else    => ch
        end
        res += escaped
        i += 1
    end
    return res
end

# Copies file from src to dst using native file operations
pub function file_copy(src, dst)
    if file_exists(src) == 0
        return 0
    end
    let content = read_file(src)
    write_file(dst, content)
    return 1
end

# Moves file from src to dst
pub function file_move(src, dst)
    if file_copy(src, dst) == 1
        remove_file(src)
        return 1
    end
    return 0
end
