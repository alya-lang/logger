## # logger/utils
##
## Utility functions for strings, time formatting, and file operations.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

## Strips ANSI escape sequences from formatted text.
##
## ### Parameters
## - `text`: Annotated text value.
##
## ### Returns
## The plain string.
pub function ansi_strip(text) -> string
    let s = str_from_ptr(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c = char_at(s, i)
                let o = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res += ch
        end
        i += 1
    end
    return res
end

## Pads an integer with a leading zero when it is a single digit.
##
## ### Parameters
## - `n`: Value integer.
##
## ### Returns
## The two-character string.
pub function pad2(n: int) -> string
    if n < 10
        return "0{n}"
    end
    return str(n)
end

## Formats UNIX epoch seconds into an HH:MM:SS string.
##
## ### Parameters
## - `secs`: Epoch seconds integer.
##
## ### Returns
## The time string.
pub function format_time_hms(secs: int) -> string
    let day_secs = secs % 86400
    let hh = (day_secs / 3600) % 24
    let mm = (day_secs / 60) % 60
    let ss = day_secs % 60
    let hh_str = pad2(hh)
    let mm_str = pad2(mm)
    let ss_str = pad2(ss)
    return "{hh_str}:{mm_str}:{ss_str}"
end

## Checks whether a string holds characters requiring quoting.
##
## ### Parameters
## - `s`: Input string.
##
## ### Returns
## `1` when quoting is needed, `0` otherwise.
pub function has_space(s: string) -> int
    let slen = len(s)
    let i = 0
    while i < slen
        let c = char_at(s, i)
        if c in [" ", "\t", "\n", "\"", "="]
            return 1
        end
        i += 1
    end
    return 0
end

## Escapes special characters for JSON encoding.
##
## ### Parameters
## - `s`: Input value.
##
## ### Returns
## The JSON-escaped string.
pub function json_escape_str(s) -> string
    let str_val = str_from_ptr(s)
    let slen = len(str_val)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(str_val, i)
        let escaped = when ch
            is "\"" => "\\\""
            is "\\" => "\\\\"
            is "\n" => "\\n"
            is "\r" => "\\r"
            is "\t" => "\\t"
            else    => ch
        end
        res += escaped
        i += 1
    end
    return res
end

## Copies a file from src to dst using native file operations.
##
## ### Parameters
## - `src`: Source path string.
## - `dst`: Destination path string.
##
## ### Returns
## `1` on success, `0` when the source is missing.
pub function file_copy(src: string, dst: string) -> int
    if file_exists(src) == 0
        return 0
    end
    let content = read_file(src)
    write_file(dst, content)
    return 1
end

## Moves a file from src to dst.
##
## ### Parameters
## - `src`: Source path string.
## - `dst`: Destination path string.
##
## ### Returns
## `1` on success, `0` otherwise.
pub function file_move(src: string, dst: string) -> int
    if file_copy(src, dst) == 1
        remove_file(src)
        return 1
    end
    return 0
end
