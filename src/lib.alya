## # logger
##
## Modern structured logging, leveled output, JSON format, and file rotation.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./core/utils.alya"
import "./core/levels.alya"
import "./core/formatters.alya"
import "./core/appenders.alya"
import "./core/logger.alya"

## Top-level factory creating a new configured AppLogger instance.
##
## ### Parameters
## - `name`: Logger name value. Defaults to `""`.
## - `level`: Minimum `LogLevel` value. Defaults to `2` (Info).
##
## ### Returns
## The new `AppLogger` instance.
pub function create(name = "", level: int = 2) -> AppLogger
    return logger_new(name, level)
end

## Factory function creating a structured LogField key-value pair.
##
## ### Parameters
## - `key`: Field key value.
## - `value`: Field value.
##
## ### Returns
## The new `LogField` instance.
pub function field(key, value) -> LogField
    return field_new(key, value)
end

## Factory function constructing a LogRecord event.
##
## ### Parameters
## - `level`: `LogLevel` value.
## - `msg`: Message value.
## - `target`: Logger target name value.
## - `timestamp`: Unix timestamp integer.
## - `fields`: `LogField` array.
##
## ### Returns
## The new `LogRecord` instance.
pub function record(level: int, msg, target, timestamp: int, fields: array) -> LogRecord
    return record_new(level, msg, target, timestamp, fields)
end

## Formats a LogRecord into a human-readable text string.
##
## ### Parameters
## - `rec`: Target `LogRecord` instance.
## - `colored`: `1` enables ANSI colors. Defaults to `0`.
## - `timestamps`: `1` prefixes timestamps. Defaults to `0`.
##
## ### Returns
## The formatted line string.
pub function format_record_text(rec: LogRecord, colored: int = 0, timestamps: int = 0) -> string
    return format_text(rec, colored, timestamps)
end

## Formats a LogRecord into a compact JSON string.
##
## ### Parameters
## - `rec`: Target `LogRecord` instance.
##
## ### Returns
## The JSON line string.
pub function format_record_json(rec: LogRecord) -> string
    return format_json(rec)
end

## Strips ANSI escape sequences from formatted text.
##
## ### Parameters
## - `text`: Annotated text value.
##
## ### Returns
## The plain string.
pub function strip_ansi(text) -> string
    return ansi_strip(text)
end

## Manually triggers log file rotation on the given path.
##
## ### Parameters
## - `path`: Log file path string.
## - `max_files`: Retained backup count integer.
##
## ### Returns
## `1` on completion.
pub function rotate_file(path: string, max_files: int) -> int
    return rotate_log_file(path, max_files)
end

## Quick global TRACE logging directly to standard output.
##
## ### Parameters
## - `msg`: Message value.
pub function log_trace(msg)
    let badge = level_badge(LogLevel.Trace, 1)
    let body = str(msg)
    say "{badge} {body}"
end
## Quick global DEBUG logging directly to standard output.
##
## ### Parameters
## - `msg`: Message value.
pub function log_debug(msg)
    let badge = level_badge(LogLevel.Debug, 1)
    let body = str(msg)
    say "{badge} {body}"
end
