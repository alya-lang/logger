## Sets the minimum threshold level on a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `level`: `LogLevel` value.
pub function set_level(l: AppLogger, level: int) return logger_set_level(l, level) end
## Enables or disables ANSI colors on a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `colored`: Flag integer.
pub function set_colored(l: AppLogger, colored: int) return logger_set_colored(l, colored) end
## Enables or disables timestamp prefixes on a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `timestamps`: Flag integer.
pub function set_timestamps(l: AppLogger, timestamps: int) return logger_set_timestamps(l, timestamps) end
## Sets the output formatting mode on a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `format`: `LogFormat` value.
pub function set_format(l: AppLogger, format: int) return logger_set_format(l, format) end
## Sets the static file destination on a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `path`: File path value.
pub function set_file(l: AppLogger, path) return logger_set_file(l, path) end

## Adds a standard console stdout appender to a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
pub function add_console(l: AppLogger) return logger_add_console(l) end
## Adds a static file destination appender to a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `path`: File path value.
pub function add_file(l: AppLogger, path) return logger_add_file(l, path) end
## Adds a rolling file appender with size limit and retention.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `path`: File path value.
## - `max_size`: Rotation threshold bytes integer.
## - `max_files`: Retained backup count integer.
pub function add_rolling_file(l: AppLogger, path, max_size: int, max_files: int) return logger_add_rolling_file(l, path, max_size, max_files) end
## Adds a persistent context key-value field to a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
## - `key`: Field key value.
## - `value`: Field value.
pub function add_field(l: AppLogger, key, value) return logger_add_field(l, key, value) end
## Clears all registered appenders from a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
pub function clear_appenders(l: AppLogger) return logger_clear_appenders(l) end
## Clears all persistent context fields from a target logger.
##
## ### Parameters
## - `l`: Target `AppLogger` instance.
pub function clear_fields(l: AppLogger) return logger_clear_fields(l) end
